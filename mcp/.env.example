# Configuration reference for the Arcade Cloud walkthrough.
# Enter this key in your Arcade demo project's Secrets settings.
# Replace the whole URL with ngrok's HTTPS forwarding origin, or your deployed API origin.
REPORT_API_BASE_URL=https://YOUR-NGROK-DOMAIN

# Tools receive this configuration through requires_secrets + Context.get_secret.
# No local .env file is required for the documented deployment flow.
# Its --secrets skip option preserves the value you entered in Arcade.
# Developer CLI authentication uses arcade login. Customers use the gateway.
