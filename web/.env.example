# Copy to .env.local. All values except DEMO_STAFF_USER_ID are required.
# Use ONE public HTTPS origin in your browser, verifier settings, and MCP API URL.
# Replace the whole URL with ngrok's HTTPS forwarding origin (no trailing slash).
APP_URL=https://YOUR-NGROK-DOMAIN
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE

# Arcade project API key. Never use NEXT_PUBLIC_ for this value.
ARCADE_API_KEY=REPLACE_WITH_ARCADE_PROJECT_KEY
# Client ID of the SECOND Clerk OAuth app: the report API provider, not User Source.
REPORTS_OAUTH_CLIENT_ID=REPLACE_WITH_REPORT_API_OAUTH_CLIENT_ID

# Create these users in the same Clerk instance and paste their actual user_ IDs.
DEMO_ALICE_USER_ID=user_REPLACE_ALICE
DEMO_BOB_USER_ID=user_REPLACE_BOB
DEMO_CAROL_USER_ID=user_REPLACE_CAROL
# Optional fourth user. Blank disables cross-workspace staff access.
DEMO_STAFF_USER_ID=
