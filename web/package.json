{
  "name": "report-mcp-demo-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "check-env": "node --import tsx scripts/check-env.ts",
    "dev": "npm run check-env && next dev",
    "build": "next build --webpack",
    "start": "npm run check-env && next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.14",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
